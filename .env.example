# Copy this file to ".env" and fill in real values. ".env" itself is
# gitignored so your secrets never get committed.

# --- Flask ---
# A long random string. If left unset, a random one is generated each time
# the app starts (fine for local single-process use; set this explicitly
# for any real deployment so sessions/CSRF tokens stay valid across restarts).
FLASK_SECRET_KEY=

# Set to 1 only for local development. Leave at 0 (or unset) anywhere the
# app might be reachable by anyone other than you — debug mode exposes an
# interactive in-browser Python debugger.
FLASK_DEBUG=0

# --- Engine selection (both are automatic; these are optional overrides) ---
# Summarizer order. The first one that works is used; if it fails (no key,
# no internet, quota, retired model) the next is tried. Options: gemini,
# openai, local. Set to just "local" to keep every transcript on this machine
# (with Gemini or OpenAI in the list, transcript text is sent to that service).
SUMMARY_BACKENDS=gemini,local
# Speech-recognition model order, best first. Only models already downloaded
# are tried first, so a model you haven't downloaded can't stall a request.
# Options: tiny, base, small, medium, large-v3.
WHISPER_MODELS=small,base,tiny
# Seconds to wait for Gemini before falling back to the next summarizer.
GEMINI_TIMEOUT_SECONDS=30

# --- Summarization backends ---
OPENAI_API_KEY=
# Paste the key on ONE line with no quotes and no trailing spaces.
GOOGLE_API_KEY=
# Optional: override the Gemini model. Google retires model names often
# (gemini-2.0-flash was shut down June 1, 2026), so change it here if a
# model stops working. Leave blank to use the app's default.
GEMINI_MODEL=

# --- Email sending (optional — only needed to use the "Send" button) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Limits (optional — sensible defaults are used if left unset) ---
MAX_UPLOAD_MB=200
MAX_AUDIO_SECONDS=3600
RESULT_RETENTION_HOURS=24
# Optional: automatically delete job history older than N days.
# Leave blank to keep history forever.
HISTORY_RETENTION_DAYS=
